{
  // Cursor Cloud Agent environment (https://cursor.com/docs/cloud-agent/setup).
  // Headless Chromium is omitted: site/ is a Rust static generator (resvg) with no
  // Lighthouse tests. Studio browser sessions belong in judge/ later.
  // cargo-nextest is omitted: CI and the justfile use `cargo test --workspace --locked`.
  "name": "Megabase",
  "user": "ubuntu",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "install": "set -euo pipefail\nexport CARGO_HOME=\"${CARGO_HOME:-$HOME/.cargo}\"\nexport RUSTUP_HOME=\"${RUSTUP_HOME:-$HOME/.rustup}\"\nexport PATH=\"$CARGO_HOME/bin:$PATH\"\nexport CARGO_TERM_COLOR=\"${CARGO_TERM_COLOR:-always}\"\nexport RUST_BACKTRACE=\"${RUST_BACKTRACE:-1}\"\n\nif ! command -v rustup >/dev/null 2>&1; then\n  arch=\"$(dpkg --print-architecture)\"\n  case \"$arch\" in\n    amd64) rustArch='x86_64-unknown-linux-gnu'; rustupSha256='dda7234360b7f578ca8b0ddcb80145646fa61a67c1720a5abc7051b35c9fcb71' ;;\n    arm64) rustArch='aarch64-unknown-linux-gnu'; rustupSha256='15f6e4ce9f583b929c996c91562bad6d4454f3281de858b02cdfdef615fac433' ;;\n    *) echo \"unsupported architecture: $arch\" >&2; exit 1 ;;\n  esac\n  curl --proto '=https' --tlsv1.2 --retry 3 --retry-delay 5 -fsSL \"https://static.rust-lang.org/rustup/archive/1.29.1/${rustArch}/rustup-init\" -o rustup-init\n  echo \"${rustupSha256} *rustup-init\" | sha256sum -c -\n  chmod +x rustup-init\n  ./rustup-init -y --profile minimal --default-toolchain none\n  rm rustup-init\n  # shellcheck disable=SC1091\n  . \"$CARGO_HOME/env\"\nfi\n\nif [ -f rust-toolchain.toml ] || [ -f rust-toolchain ]; then\n  rustup show\nelse\n  rustup toolchain install stable --profile minimal --component rustfmt --component clippy --component llvm-tools\n  rustup default stable\nfi\nrustup component add rustfmt clippy llvm-tools\n\nif ! command -v cargo-binstall >/dev/null 2>&1; then\n  arch=\"$(dpkg --print-architecture)\"\n  case \"$arch\" in\n    amd64) binstallTriple='x86_64-unknown-linux-musl'; binstallSha256='2b8687cb3297d335efdac1ee839fab47ac4c2b8f5f90b9e290aa7ba52f607803' ;;\n    arm64) binstallTriple='aarch64-unknown-linux-musl'; binstallSha256='f4d921de650ee4e04cb8ade2c1476987d21d55c23786d810a2913817c6134b94' ;;\n    *) echo \"unsupported architecture: $arch\" >&2; exit 1 ;;\n  esac\n  curl --proto '=https' --tlsv1.2 --retry 3 --retry-delay 5 -fsSL \"https://github.com/cargo-bins/cargo-binstall/releases/download/v1.25.2/cargo-binstall-${binstallTriple}.tgz\" -o cargo-binstall.tgz\n  echo \"${binstallSha256} *cargo-binstall.tgz\" | sha256sum -c -\n  mkdir -p \"$CARGO_HOME/bin\"\n  tar -xzf cargo-binstall.tgz -C \"$CARGO_HOME/bin\" cargo-binstall\n  rm cargo-binstall.tgz\nfi\n\nbinstall_if_missing() {\n  if ! command -v \"$1\" >/dev/null 2>&1; then\n    cargo binstall -y \"$2\"\n  fi\n}\nbinstall_if_missing just just\nbinstall_if_missing cargo-deny cargo-deny\nbinstall_if_missing cargo-audit cargo-audit\nbinstall_if_missing cargo-llvm-cov cargo-llvm-cov\n# cargo-nextest is not used by CI or the justfile (`cargo test --workspace --locked`).\n\nif [ -f .gitmodules ]; then\n  git submodule update --init --recursive\nfi\n\nlink_bin() {\n  src=\"$CARGO_HOME/bin/$1\"\n  if [ -x \"$src\" ]; then\n    sudo ln -sfn \"$src\" \"/usr/local/bin/$1\"\n  fi\n}\nfor b in rustup rustc cargo rustfmt cargo-clippy cargo-fmt clippy-driver just cargo-deny cargo-audit cargo-llvm-cov cargo-binstall; do\n  link_bin \"$b\"\ndone\n\n# Warm the registry and the cargo check cache. Agents iterate with\n# `cargo check`, so a cold `cargo build` is the wrong artifact.\nif [ -f Cargo.lock ]; then\n  cargo fetch --locked\n  cargo check --workspace --all-targets --locked\nelif [ -f site/Cargo.toml ]; then\n  cargo fetch --locked --manifest-path site/Cargo.toml\n  cargo check --all-targets --locked --manifest-path site/Cargo.toml\nfi\n",
  "start": "set -euo pipefail\nif ! command -v docker >/dev/null 2>&1; then\n  echo \"Docker is not available in this Cloud Agent VM. The judge reference stack (just judge-up, vendor/supabase/docker) needs a Docker daemon. Builds from .cursor/Dockerfile install Docker Engine with fuse-overlayfs; on the default image, install Docker or skip judge-up.\"\n  exit 0\nfi\n\ndocker_ready() {\n  docker info >/dev/null 2>&1 || sudo docker info >/dev/null 2>&1\n}\n\nif docker_ready; then\n  exit 0\nfi\n\nif command -v service >/dev/null 2>&1; then\n  sudo service docker start || true\nfi\nn=0\nuntil docker_ready; do\n  n=$((n + 1))\n  if [ \"$n\" -eq 5 ] && ! pgrep -x dockerd >/dev/null 2>&1; then\n    mkdir -p /tmp/cursor/start-user\n    sudo dockerd >/tmp/cursor/start-user/dockerd.log 2>&1 &\n  fi\n  if [ \"$n\" -ge 30 ]; then\n    echo \"Docker daemon did not become ready\" >&2\n    exit 1\n  fi\n  sleep 1\ndone\n",
  "ports": [
    {
      "name": "judge-reference",
      "port": 8000
    },
    {
      "name": "megabase",
      "port": 8100
    }
  ]
}
